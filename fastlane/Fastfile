# Fastlane — bygger iOS-appen + laddar upp till TestFlight via App Store Connect.
# MANUELL distributions-signering: cert (Apple Distribution) + sigh (app-store-profil)
# via API-nyckeln, importerade i setup_ci:s temporära nyckelring (ingen codesign-hang).
default_platform(:ios)

platform :ios do
  desc "Bygg + ladda upp till TestFlight"
  lane :beta do
    # Temporär, upplåst CI-nyckelring → codesign hänger inte på en lösenords-dialog.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],          # base64-kodad .p8-nyckel (GitHub-secret)
      is_key_content_base64: true,
      in_house: false
    )

    # Unikt, ständigt ökande build-nummer (krävs av TestFlight). GitHub run-number.
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || Time.now.to_i.to_s
    )

    app_id = ENV["APP_ID"] || "com.warparty.game"

    # Distributions-cert (importeras i setup_ci-nyckelringen med känt lösenord så
    # partition-list kan sättas → codesign frågar inte efter lösenord).
    cert(
      api_key: api_key,
      output_path: "fastlane/certs",
      keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )
    # App-store-provisioning-profil för bundle-ID:t.
    sigh(
      api_key: api_key,
      app_identifier: app_id,
      platform: "ios",
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # Manuell signering med team + den hämtade profilen.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "WarParty.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["TEAM_ID"],
        provisioningProfiles: { app_id => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
