# Fastlane — bygger iOS-appen + laddar upp till TestFlight via App Store Connect.
# MOLN-SIGNERING (automatic + -allowProvisioningUpdates): Apple skapar/återanvänder
# en moln-hanterad distributions-cert + profil via API-nyckeln. Ingen lokal cert-
# hantering → ingen "max distribution certificates"-gräns, fungerar på en fräsch CI-Mac.
require "base64"
default_platform(:ios)

platform :ios do
  desc "Bygg + ladda upp till TestFlight"
  lane :beta do
    # Temporär CI-nyckelring (xcodebuild laddar ner moln-certet hit utan UI-dialog).
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],          # base64-kodad .p8-nyckel (GitHub-secret)
      is_key_content_base64: true,
      in_house: false
    )

    # Unikt, ständigt ökande build-nummer (krävs av TestFlight). GitHub run-number.
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || Time.now.to_i.to_s
    )

    # Automatisk signering med team — Apple sköter cert + profil i molnet.
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["TEAM_ID"],
      targets: ["App"]
    )

    # Skriv .p8-nyckeln till fil så xcodebuild kan autentisera mot Apple och göra
    # moln-signeringen (annars "No Accounts"). gym skickar inte nyckeln automatiskt.
    asc_key_path = File.expand_path("fastlane/asc_api_key.p8")
    File.write(asc_key_path, Base64.decode64(ENV["ASC_KEY_P8"]))

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "WarParty.ipa",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{asc_key_path} " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["TEAM_ID"]
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
